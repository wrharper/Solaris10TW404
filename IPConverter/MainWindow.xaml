<Window x:Class="IPConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP to Decimal Converter" Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="IP to Decimal Converter" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="#4CAF50" Margin="0,0,0,15"/>
            
            <TextBlock Text="IP Address:" 
                       FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,6"/>
            <TextBox x:Name="IpAddressInput" 
                     Height="38" Padding="8"
                     FontSize="12"
                     GotFocus="IpAddressInput_GotFocus"
                     LostFocus="IpAddressInput_LostFocus"
                     Background="#2D2D2D"
                     Foreground="#FFFFFF"
                     BorderThickness="1"
                     BorderBrush="#3D3D3D"
                     Margin="0,0,0,12"/>
            
            <Button Content="Convert" 
                    Click="ConvertButton_Click"
                    Height="36" FontSize="12" FontWeight="Bold"
                    Background="#4CAF50" Foreground="White"
                    Cursor="Hand" Margin="0,0,0,12"/>
            
            <TextBlock Text="Result:" 
                       FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,6"/>
            <TextBox x:Name="ResultOutput" 
                     Height="36" Padding="8"
                     FontSize="13" FontWeight="Bold"
                     Foreground="#4CAF50"
                     Background="#2D2D2D"
                     IsReadOnly="True"
                     BorderThickness="1"
                     BorderBrush="#3D3D3D"
                     Margin="0,0,0,10"/>
            
            <Button Content="Copy to Clipboard" 
                    Click="CopyButton_Click"
                    Height="32" FontSize="11"
                    Background="#2196F3" Foreground="White"
                    Cursor="Hand" Margin="0,0,0,10"/>
            
            <TextBlock x:Name="ErrorMessage" 
                       FontSize="11" Foreground="#FF6B6B"
                       TextWrapping="Wrap" Margin="0,0,0,8" MinHeight="44"/>
            
            <TextBlock FontSize="10" Foreground="#707070" TextWrapping="Wrap">
                <Run>Formula for IP a.b.c.d: </Run>
                <Run FontFamily="Courier New" Foreground="#808080">(d×256³) + (c×256²) + (b×256) + a</Run>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
